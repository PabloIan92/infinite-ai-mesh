/**
 * Infinite AI Mesh - Telegram Daemon Bridge Template
 * Connects mobile Telegram chats directly to the headless CLI orchestrator
 */

import { spawn } from 'node:child_process';
import path from 'node:path';

// Environmental Configuration (Populated via PM2 / system environment)
const TELEGRAM_BOT_TOKEN = process.env.TELEGRAM_BOT_TOKEN || '<YOUR_TELEGRAM_BOT_TOKEN>';
const ALLOWED_CHAT_ID = process.env.ALLOWED_CHAT_ID ? Number(process.env.ALLOWED_CHAT_ID) : null;
const WORKSPACE_DIR = process.env.WORKSPACE_DIR || process.cwd();

// Fallback Chain
const ENGINES = {
  PRIMARY: 'gemini-3.8-flash-medium', // Headless Antigravity
  SECONDARY: 'nvidia/nemotron-3.5-super-vl-120b-a12b', // NVIDIA NIM Offload
  OFFLINE: 'qwen2.5-coder:14b', // Local Ollama
};

async function executeAgentCLI(prompt: string, model: string): Promise<string> {
  return new Promise((resolve, reject) => {
    // Spawns the headless CLI with autonomous permissions
    const child = spawn('agy', [
      '-c',
      '--model', model,
      '--dangerously-skip-permissions',
      '-p', prompt
    ], {
      cwd: WORKSPACE_DIR,
      env: process.env,
    });

    let stdout = '';
    let stderr = '';

    child.stdout.on('data', (chunk) => { stdout += chunk.toString(); });
    child.stderr.on('data', (chunk) => { stderr += chunk.toString(); });

    child.on('close', (code) => {
      if (code === 0) {
        resolve(stdout.trim());
      } else {
        // If quota limit detected, fallback to next tier
        console.warn(`Primary engine exited with code ${code}. Stderr: ${stderr}`);
        resolve(`[Engine Notice]: ${stdout || stderr}`);
      }
    });

    child.on('error', (err) => reject(err));
  });
}

console.log('Infinite AI Mesh Telegram Bridge ready. Listening for mobile commands...');
